# --- AWS (rotate the original keys you posted earlier!) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_MEDIA_BUCKET=humanityarchived-media
CLOUDFRONT_DOMAIN=

# --- Postgres (RDS) ---
DATABASE_URL=

# --- GitHub (for submission PRs) ---
GITHUB_OWNER=
GITHUB_REPO=humanity-archived
GITHUB_TOKEN=
GITHUB_DEFAULT_BRANCH=main

# --- Email ---
RESEND_API_KEY=
NOTIFY_EMAIL=viraat@exla.ai

# --- Translation (Google Gemini; cheap + fast) ---
GOOGLE_API_KEY=
# Default model for accessible-English translation. Any Gemini model id works.
TRANSLATION_MODEL=gemini-2.5-flash

# --- Search: hybrid Postgres FTS + pg_trgm + pgvector ---
# Embedding provider for the semantic mode. `gemini` is the default.
EMBEDDING_PROVIDER=gemini
# Google AI Studio API key (https://aistudio.google.com/apikey).
# Used for both translation (above) and embeddings; may be the same key.
GEMINI_API_KEY=
# Optional swap-ins for embeddings only (set EMBEDDING_PROVIDER accordingly):
# VOYAGE_API_KEY=
# OPENAI_API_KEY=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
